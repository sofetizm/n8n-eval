    "parameters": {
     "notice": "",
     "noticeTemplateExample": "",
     "description": "Возвращает статус заказа, сроки доставки и трек-номер по номеру заказа.",
     "language": "javaScript",
     "jsCode": "const orders = {\n  \"1001\": \"Доставлен 28 октября.\",\n  \"1042\": \"Отправлен 2 ноября, трек-номер RU123456789, доставка ожидается 6 ноября.\",\n  \"1077\": \"Собирается на складе, отправка 5 ноября.\",\n  \"1100\": \"Отменён по просьбе покупателя, деньги возвращены 1 ноября.\",\n  \"1123\": \"Ожидает оплаты; заказ отправим после оплаты.\"\n};\nconst id = String(query.order_number || \"\").replace(/\\D/g, \"\");\nreturn orders[id] ? `Заказ ${id}: ${orders[id]}` : `Заказ ${id} не найден.`;",
     "specifyInputSchema": true,
     "schemaType": "manual",
     "inputSchema": "{\"type\": \"object\", \"properties\": {\"order_number\": {\"type\": \"string\", \"description\": \"Номер заказа, например 1042\"}}, \"required\": [\"order_number\"]}"
    },
    "id": "3ff0f154-caed-4c2f-b8e7-b3adfa1c2c48",
    "rewireOutputLogTo": "ai_tool"
   },
   {
    "name": "search_policy",
    "type": "@n8n/n8n-nodes-langchain.toolCode",
    "typeVersion": 1.3,
    "position": [
     500,
     240
    ],
    "parameters": {
     "notice": "",
     "noticeTemplateExample": "",
     "description": "Ищет правила магазина: доставка, оплата, возврат, сертификаты, бонусы, самовывоз.",
     "language": "javaScript",
     "jsCode": "const policies = [\n  [\"доставка доставку стоимость бесплатно курьер сроки\", \"Доставка курьером 1–3 дня, стоимость 299 ₽; бесплатно для заказов от 2000 ₽.\"],\n  [\"возврат вернуть обмен книга понравилась электронная\", \"Бумажную книгу можно вернуть в течение 14 дней, если на ней нет следов использования. Электронные книги вернуть нельзя.\"],\n  [\"оплата оплатить карта сбп наличные рассрочка кредит\", \"Оплата картой, через СБП или наличными курьеру. Рассрочки и кредита нет.\"],\n  [\"сертификат подарочный подарок номинал срок\", \"Подарочные сертификаты номиналом 1000, 3000 и 5000 ₽, действуют 1 год с даты покупки.\"],\n  [\"бонусы бонус баллы кешбэк начисляют списать\", \"За покупку начисляется 5% бонусами; бонусами можно оплатить до 30% суммы заказа.\"],\n  [\"самовывоз забрать пункт адрес часы работы\", \"Пункт самовывоза: ул. Ленина, 10, ежедневно с 10:00 до 21:00.\"]\n];\nconst words = String(query.query || \"\").toLowerCase().replace(/ё/g, \"е\").split(/[^a-zа-я0-9]+/).filter(w => w.length > 2);\nconst scored = policies.map(([keys, text]) => [words.filter(w => keys.includes(w.slice(0, 5))).length, text]);\nconst found = scored.filter(([s]) => s > 0).sort((a, b) => b[0] - a[0]).map(([, t]) => t);\nreturn found.length ? found.join(\"\\n\") : \"В правилах магазина нет информации по этому вопросу.\";",
     "specifyInputSchema": true,
     "schemaType": "manual",
     "inputSchema": "{\"type\": \"object\", \"properties\": {\"query\": {\"type\": \"string\", \"description\": \"Вопрос клиента или ключевые слова\"}}, \"required\": [\"query\"]}"
